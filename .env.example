# Database Connection for Vanuit Ambacht PostgreSQL
# Note: Space in database name 'vanuit ambacht' is URL-encoded as %20
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/vanuit%20ambacht

# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT Secret
JWT_SECRET=super_secret_vanuit_ambacht_jwt_key_2026
